# Copiá este archivo como variables secretas en tu hosting (no lo subas con valores reales).
ANTHROPIC_API_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=          # cadena larga al azar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAGO_ALIAS=[ALIAS]
PAGO_TITULAR=[NOMBRE]
PAGO_MONTO=20000
NOTIFY_WEBHOOK_URL=      # opcional: ej. https://ntfy.sh/tu-tema-secreto para recibir avisos en el celular
DATA_DIR=./data          # en producción, un disco persistente
RETENCION_DIAS=30
NODE_ENV=production
# MOCK_IA=1              # sólo para pruebas locales sin API key
